# ───────────────────────────────────────────────────────────────
# Root .env – used by docker-compose.yml.   cp .env.example .env
# NEVER commit .env.  Generate secrets with:  openssl rand -hex 48
# ───────────────────────────────────────────────────────────────
POSTGRES_USER=idas
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_24   # hex avoids URL-encoding problems
POSTGRES_DB=idas
POSTGRES_PORT=5432

JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_48     # reserved; refresh tokens are opaque, hashed, DB-stored
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
COOKIE_SECURE=false          # set true behind HTTPS in production
LAB_TIMEZONE=Asia/Colombo
SWAGGER_ENABLED=true         # set false in production if you do not want public API docs

# Demo seed password (development only!). Leave empty to use the documented default.
SEED_DEMO_PASSWORD=
